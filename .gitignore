# Python
__pycache__/

# Pixi
.pixi/*
!.pixi/config.toml

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ML / training artifacts
mlruns/
# MLflow metadata in SQLite (A1's mlflow.db, a per-job store on a cluster, any name), with
# SQLite's side files (write-ahead log, shared memory, rollback journal) next to any database.
mlflow*.db
mlruns*.db
*.db-wal
*.db-shm
*.db-journal
# Artifacts of an MLflow tracking server (its default --artifacts-destination), and the file store
# kept from before the SQLite migration.
mlartifacts/
mlruns_backup_*/
lightning_logs/
mlflow_exports/
optuna_studies/
notebooks/basemap_cache/
notebooks/figures/

# Build artifacts
build/
dist/
*.egg-info/

# OS / editor noise
.DS_Store
.vscode/

# Datasets
*.csv
*.png

# Documentation build output
docs/_build/

# Generated example data (python examples/make_demo_data.py)
examples/demo_data/

# Generated by the Paper A1 experiments under their output_dir (preflight reports, split plans,
# runs): results/a1/ for the real data, results/a1_demo/ for the demo. Rebuilt by the scripts in
# experiments/a1/, so never committed.
results/a1*/
